<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 原生层只做纯色过渡：Android 12+ 的系统 SplashScreen 强制显示应用图标，
         windowBackground 里的图在那套机制下不生效（真机实测只看到圆形图标）。
         全屏插画由 Flutter 首帧的 SplashGate 负责（assets/splash.jpg），
         这里保持同色，避免"图标 → 插画"两段跳。 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F4F0"/>
        </shape>
    </item>
</layer-list>
